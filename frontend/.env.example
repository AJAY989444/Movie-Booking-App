# For production (Render), set VITE_API_URL as a Build Argument in the dashboard

# Local development (default — no file needed, fallback is used)
VITE_API_URL=http://localhost:8080/api

# Production example (your Render backend URL)
# VITE_API_URL=https://cinepass-backend.onrender.com/api
